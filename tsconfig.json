{
    "compileOnSave": true,
    "compilerOptions": {
        "module": "ESNext",
        "lib": ["DOM", "ES2020"],
        "alwaysStrict": true,
        "esModuleInterop": true,
        "incremental": false,
        "target": "ES2020",
        "moduleResolution": "node",
        "noImplicitAny": false,
        "outDir": "dist",
        "removeComments": true,
        "rootDir": "src",
        "sourceMap": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
