{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["DOM", "ES2022"],
        "target": "ES2022",
        "rootDir": "./src",
        "outDir": "./dist",

        "strict": true,
        "strictNullChecks": false,

        "noImplicitAny": true,
        "alwaysStrict": true,
        "verbatimModuleSyntax": true,

        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "removeComments": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
